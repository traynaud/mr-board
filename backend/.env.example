# Copier en .env — ne jamais committer .env
PORT=3000
# Fichier SQLite (":memory:" pour une base volatile)
DB_PATH=./data/mr-board.sqlite
# Clé de chiffrement du jeton GitLab (>= 16 caractères, à générer : openssl rand -hex 32)
APP_SECRET=change-me-with-a-long-random-secret
# Origine du frontend autorisée par CORS
CORS_ORIGIN=http://localhost:4200
# error | warn | log | debug | verbose
LOG_LEVEL=log
