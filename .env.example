# Variables lues par docker compose (copier vers .env — jamais committé)
# Clé de chiffrement du jeton GitLab (>= 16 caractères) : openssl rand -hex 32
APP_SECRET=change-me-with-a-long-random-secret
# Port exposé sur l'hôte
MR_BOARD_PORT=3000
# Origine autorisée par CORS (doit correspondre à l'URL d'accès)
CORS_ORIGIN=http://localhost:3000
# error | warn | log | debug | verbose
LOG_LEVEL=log
