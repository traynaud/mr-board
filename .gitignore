# =============================================
# BACKEND - NestJS / SQLite
# =============================================

# --- Dépendances & build ---
backend/node_modules/
backend/dist/
backend/coverage/
backend/*.tsbuildinfo

# --- Base de données SQLite locale ---
backend/data/
backend/*.sqlite
backend/*.sqlite-journal
backend/*.sqlite-wal
backend/*.sqlite-shm
backend/*.db

# --- Variables d'environnement (contient le jeton GitLab) ---
backend/.env
backend/.env.local
backend/.env.*.local

# --- Logs & fichiers temporaires ---
backend/*.log
backend/logs/
backend/.eslintcache


# =============================================
# FRONTEND - Angular
# =============================================

# --- Dépendances Node ---
frontend/node_modules/

# --- Build Angular ---
frontend/dist/
frontend/.angular/

# --- Cache & fichiers temporaires ---
frontend/.sass-cache/
frontend/tmp/
frontend/.eslintcache

# --- Couverture de tests & Playwright ---
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# --- Variables d'environnement locales ---
frontend/.env
frontend/.env.local


# =============================================
# RACINE - Général
# =============================================

# --- IDE JetBrains ---
.idea/
*.iml
*.iws
*.ipr

# --- VS Code ---
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Variables d'environnement ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker (surcharges locales) ---
docker-compose.override.yml
docker-compose-prod.yml

# --- Docker (base SQLite persistée hors container, bind mount ./data) ---
/data/*
!/data/.gitkeep


# =============================================
# CLAUDE CODE
# =============================================

# On GARDE le fichier de config Claude (.claude/ ou CLAUDE.md)
# mais on ignore les fichiers de session/cache générés
.claude/tmp/
.claude/logs/
.claude/.session*
.claude/*.local.json

# Note : NE PAS ignorer ces fichiers (ils doivent être versionnés) :
#   - CLAUDE.md (instructions projet pour Claude)
#   - .claude/settings.json (configuration partagée)
#   - .claude/commands/*.md (workflows et agents)

/graphify-out/